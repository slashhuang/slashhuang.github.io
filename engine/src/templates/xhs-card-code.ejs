<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
</head>
<body style="margin: 0; padding: 0;">
<div class="xhs-card" style="width: 1080px; min-height: 1440px; padding: 80px; box-sizing: border-box; background: #1e1e2e; font-family: 'JetBrains Mono', 'Fira Code', monospace; color: #cdd6f4;">
  <div class="card-header" style="margin-bottom: 48px;">
    <div class="title" style="font-size: 48px; font-weight: 700; line-height: 1.3; letter-spacing: 1px; margin-bottom: 24px; color: #cba6f7;"><%= title %></div>
    <div class="author" style="font-size: 24px; color: #6c7086;">@<%= author %></div>
  </div>
  <div class="card-body" style="font-size: 30px; line-height: 1.8; margin-bottom: 48px; background: #181825; padding: 32px; border-radius: 16px;">
    <%- body %>
  </div>
  <div class="card-footer" style="padding-top: 32px; border-top: 1px solid #45475a;">
    <% tags.forEach(function(tag) { %>
    <span class="tag" style="margin-right: 16px; font-size: 24px; color: #a6adc8;"><%= tag %></span>
    <% }) %>
  </div>
</div>
</body>
</html>
